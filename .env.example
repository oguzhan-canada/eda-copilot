# Neo4j connection configuration
# Copy to .env and fill in values from Neo4j Aura console

# Neo4j Aura Free Tier — provision at https://console.neo4j.io
# 1. Create account (or sign in)
# 2. Create new instance → "Free" tier → name: "eda-kg-dev"
# 3. Copy the generated password immediately (shown only once)
# 4. Connection URI format: neo4j+s://<instance-id>.databases.neo4j.io

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<paste-from-aura-console>

# After provisioning, test with:
#   python -m pipeline.graph.load_neo4j --uri $NEO4J_URI --password $NEO4J_PASSWORD
#
# Run smoke tests:
#   pytest tests/test_graph_loader.py -v
